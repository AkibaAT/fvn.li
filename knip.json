{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "resources/js/pages/**/*.svelte"
  ],
  "project": [
    "resources/js/**/*.{ts,svelte}"
  ],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "flag-icons",
    "svelte-check",
    "tailwindcss",
    "tinymce",
    "ziggy-js"
  ],
  "paths": {
    "@/*": ["resources/js/*"]
  }
}
