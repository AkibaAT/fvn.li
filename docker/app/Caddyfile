{
	{$CADDY_GLOBAL_OPTIONS}

	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	frankenphp {
        php_ini {
            memory_limit 1G
            max_execution_time 60
            max_input_time 60
        }

		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			{$CADDY_SERVER_WATCH_DIRECTIVES}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$CADDY_SERVER_SERVER_NAME} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL}

		# Redact the authorization query parameter that can be set by Mercure...
		format filter {
			wrap {$CADDY_SERVER_LOGGER}
			fields {
				uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	route {
		root * "{$APP_PUBLIC_PATH}"
		encode zstd br gzip

		# Block specific user agents
		@blocked_bots {
			header User-Agent "*MJ12bot/v1.4.8*"
			header User-Agent "*DotBot/1.2*"
		}

		# Return 403 for blocked bots
		handle @blocked_bots {
			respond "Access denied" 403
		}

		# Handle collage images with fallback to social-fallback.jpg
		@collage_images {
			path_regexp collage ^/storage/social-images/collage_.*\.(webp|jpg|jpeg|png)$
		}
		handle @collage_images {
			try_files {path} /images/social-fallback.jpg
			header Cache-Control "public, max-age=31536000, immutable"
		}

		# Serve static files directly and efficiently (but not Livewire requests)
		@static_files {
			path_regexp \.(css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|eot|otf|map|json|xml|txt|pdf|zip|mp4|webm|ogg)$
			not path /livewire/*
		}
		handle @static_files {
			# Try to serve the file, return 404 if not found (don't invoke Laravel)
			try_files {path}
			file_server {
				precompressed br gzip
			}
		}

		# Mercure configuration is injected here...
		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		# Handle all other requests with PHP/Laravel
		php_server {
			index frankenphp-worker.php
			# Required for the public/storage/ directory...
			resolve_root_symlink
		}
	}
}
