{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun run manifest && vite build",
        "build:ssr": "bun run manifest && vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "manifest": "node scripts/generate-web-manifest.mjs",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types": "svelte-check --tsconfig ./tsconfig.json",
        "test:js": "vitest run --config vitest.config.ts",
        "test:js:coverage": "vitest run --config vitest.config.ts --coverage",
        "test:e2e": "bash scripts/playwright-ddev.sh test --grep-invert @accessibility",
        "test:e2e:ui": "PW_TEST_CONNECT_WS_ENDPOINT=${PW_TEST_CONNECT_WS_ENDPOINT:-ws://playwright:3000/} playwright test --ui",
        "test:a11y": "bash scripts/playwright-ddev.sh test tests/e2e/specs/accessibility.spec.ts --grep @accessibility",
        "test:a11y:headed": "SESSION_DRIVER=${SESSION_DRIVER:-database} E2E_START_LARAVEL_SERVER=${E2E_START_LARAVEL_SERVER:-1} E2E_BASE_URL=${E2E_BASE_URL:-http://web:8088} PW_TEST_CONNECT_WS_ENDPOINT=${PW_TEST_CONNECT_WS_ENDPOINT:-ws://playwright:3000/} playwright test tests/e2e/specs/accessibility.spec.ts --grep @accessibility --headed",
        "test:a11y:report": "playwright show-report"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.60.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/svelte": "5.3.1",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "25.9.1",
        "@vitest/coverage-v8": "4.1.8",
        "baseline-browser-mapping": "2.10.33",
        "concurrently": "10.0.3",
        "eslint": "10.4.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-svelte": "3.19.0",
        "jsdom": "29.1.1",
        "prettier": "3.8.3",
        "prettier-plugin-svelte": "4.1.0",
        "prettier-plugin-tailwindcss": "0.8.0",
        "svelte-check": "4.6.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.60.1",
        "vite": "8.0.16",
        "vitest": "4.1.8"
    },
    "dependencies": {
        "@dnd-kit-svelte/svelte": "0.1.6",
        "@dnd-kit/helpers": "0.4.0",
        "@inertiajs/svelte": "3.3.1",
        "@sveltejs/vite-plugin-svelte": "7.1.2",
        "@tailwindcss/typography": "0.5.19",
        "@tailwindcss/vite": "4.3.0",
        "@xyflow/svelte": "1.6.0",
        "axios": "1.17.0",
        "chart.js": "4.5.1",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "elkjs": "0.11.1",
        "flag-icons": "7.5.0",
        "globals": "17.6.0",
        "laravel-vite-plugin": "3.1.0",
        "svelte": "5.56.2",
        "svelte5-chartjs": "1.0.0",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.0",
        "tailwindcss-animate": "1.0.7",
        "tinymce": "8.6.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.61.1",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
        "lightningcss-linux-x64-gnu": "1.32.0"
    },
    "overrides": {
        "axios": "1.16.1",
        "devalue": "5.8.1",
        "flatted": "3.4.2",
        "lodash-es": "4.18.1",
        "picomatch": "4.0.4",
        "shell-quote": "1.8.4"
    }
}
