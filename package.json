{
    "private": true,
    "type": "module",
    "scripts": {
        "assets:tinymce": "node scripts/sync-tinymce-assets.mjs",
        "build": "bun run manifest && bun run assets:tinymce && vite build",
        "build:ssr": "bun run manifest && bun run assets:tinymce && vite build && vite build --ssr",
        "dev": "bun run assets:tinymce && vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "manifest": "node scripts/generate-web-manifest.mjs",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "knip": "knip",
        "types": "node scripts/svelte-check.mjs --tsconfig ./tsconfig.json",
        "test:js": "vitest run --config vitest.config.ts",
        "test:js:coverage": "vitest run --config vitest.config.ts --coverage",
        "test:e2e": "bash scripts/playwright-ddev.sh test --grep-invert @accessibility",
        "test:e2e:ui": "PW_TEST_CONNECT_WS_ENDPOINT=${PW_TEST_CONNECT_WS_ENDPOINT:-ws://playwright:3000/} playwright test --ui",
        "test:a11y": "bash scripts/playwright-ddev.sh test tests/e2e/specs/accessibility.spec.ts --grep @accessibility",
        "test:a11y:headed": "SESSION_DRIVER=${SESSION_DRIVER:-database} E2E_START_LARAVEL_SERVER=${E2E_START_LARAVEL_SERVER:-1} E2E_BASE_URL=${E2E_BASE_URL:-http://web:8088} PW_TEST_CONNECT_WS_ENDPOINT=${PW_TEST_CONNECT_WS_ENDPOINT:-ws://playwright:3000/} playwright test tests/e2e/specs/accessibility.spec.ts --grep @accessibility --headed",
        "test:a11y:report": "playwright show-report"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/svelte": "5.4.2",
        "@types/node": "26.6.2",
        "@vitest/coverage-v8": "5.0.2",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-svelte": "3.23.0",
        "jsdom": "30.1.1",
        "knip": "6.38.0",
        "prettier": "3.9.9",
        "prettier-plugin-svelte": "4.1.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "svelte-check": "4.7.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    },
    "dependencies": {
        "@dnd-kit-svelte/svelte": "0.1.6",
        "@dnd-kit/dom": "0.5.0",
        "@dnd-kit/helpers": "0.5.0",
        "@inertiajs/core": "3.7.1",
        "@inertiajs/svelte": "3.7.1",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.3",
        "@xyflow/svelte": "1.7.0",
        "axios": "1.20.0",
        "chart.js": "4.5.1",
        "clsx": "2.1.1",
        "flag-icons": "7.5.0",
        "globals": "17.12.0",
        "laravel-vite-plugin": "3.2.0",
        "svelte": "5.57.1",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.3",
        "tinymce": "8.9.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.63.5",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
        "lightningcss-linux-x64-gnu": "1.33.0"
    },
    "overrides": {
        "brace-expansion": "5.0.9",
        "devalue": "5.8.1",
        "flatted": "3.4.2",
        "form-data": "4.0.6",
        "lodash-es": "4.18.1",
        "nanoid": "3.3.18",
        "picomatch": "4.0.4",
        "postcss": "8.5.25",
        "qs": "6.15.2",
        "shell-quote": "1.8.4",
        "yaml": "2.9.0"
    }
}
