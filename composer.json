{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-zip": "*",
        "blade-ui-kit/blade-heroicons": "^2.5",
        "fakerphp/faker": "^1.24",
        "filament/filament": "^3.3",
        "guzzlehttp/guzzle": "*",
        "http-interop/http-factory-guzzle": "^1.2",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.11",
        "itsgoingd/clockwork": "*",
        "laravel/framework": "^12.0",
        "laravel/nightwatch": "^1.7",
        "laravel/octane": "*",
        "laravel/sanctum": "*",
        "laravel/scout": "^10.14",
        "laravel/tinker": "*",
        "livewire/livewire": "^3.5",
        "meilisearch/meilisearch-php": "^1.13",
        "minishlink/web-push": "^9.0",
        "predis/predis": "*",
        "sabberworm/php-css-parser": "^8.8",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/steam": "^4.3",
        "socialiteproviders/telegram": "^4.1",
        "spatie/laravel-schedule-monitor": "^3.9",
        "spatie/laravel-sitemap": "^7.3",
        "tightenco/ziggy": "^2.5",
        "tpetry/laravel-postgresql-enhanced": "*"
    },
    "require-dev": {
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.19",
        "mockery/mockery": "*",
        "nunomaduro/collision": "*",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "*",
        "spatie/laravel-ignition": "*",
        "tightenco/duster": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/canonical.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "./vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
