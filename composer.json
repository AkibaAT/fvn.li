{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-zip": "*",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "filament/filament": "^5.6",
        "guzzlehttp/guzzle": "^7.10",
        "http-interop/http-factory-guzzle": "^1.2",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image": "^4.0",
        "itsgoingd/clockwork": "^5.3",
        "laravel/framework": "^13.0",
        "laravel/nightwatch": "^1.26",
        "laravel/octane": "^2.17",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.1",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "meilisearch/meilisearch-php": "^1.16",
        "minishlink/web-push": "^11.0",
        "predis/predis": "^3.4",
        "sabberworm/php-css-parser": "^9.3",
        "socialiteproviders/discord": "^4.2",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/steam": "^4.3",
        "socialiteproviders/telegram": "^4.1",
        "spatie/laravel-schedule-monitor": "^4.3",
        "spatie/laravel-sitemap": "^8.1",
        "tightenco/ziggy": "^2.6",
        "tpetry/laravel-postgresql-enhanced": "^3.6"
    },
    "require-dev": {
        "fakerphp/faker": "*",
        "laravel/boost": "*",
        "laravel/pail": "*",
        "laravel/pint": "*",
        "mockery/mockery": "*",
        "nunomaduro/collision": "*",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "*",
        "spatie/laravel-ignition": "*",
        "tightenco/duster": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/canonical.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@test:all"
        ],
        "test:php": "php artisan test --env=testing --testsuite=Unit,Feature",
        "test:browser": "bun run test:e2e",
        "test:a11y": "bun run test:a11y",
        "test:browser:pest": "bash scripts/pest-browser-ddev.sh",
        "test:frontend": [
            "bun run test:js:coverage",
            "@test:browser:pest"
        ],
        "test:all": [
            "@test:php",
            "@test:frontend",
            "@test:browser",
            "@test:a11y"
        ],
        "test:coverage": "XDEBUG_MODE=coverage php artisan test --env=testing --testsuite=Unit,Feature --coverage",
        "test:coverage:clover": "mkdir -p build/logs && XDEBUG_MODE=coverage php artisan test --env=testing --testsuite=Unit,Feature --coverage-clover=build/logs/clover.xml",
        "test:coverage:audit": "php scripts/audit-php-coverage.php build/logs/clover.xml",
        "test:parallel": "php artisan test --env=testing --parallel",
        "test:unit": "php artisan test --env=testing --testsuite=Unit",
        "test:feature": "php artisan test --env=testing --testsuite=Feature",
        "migrate:test": "php artisan migrate:fresh --seed --env=testing",
        "lint": "php vendor/bin/duster lint",
        "lint:fix": "php vendor/bin/duster fix",
        "hooks:install": "git config core.hooksPath .githooks"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
